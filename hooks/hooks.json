{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/claude-code.sh SessionStart" }]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/claude-code.sh SubagentStart" }]
      }
    ]
  }
}
